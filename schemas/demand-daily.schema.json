{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "horizon/schemas/demand-daily.schema.json",
  "title": "Demand daily row",
  "description": "One row per date × region × channel × platform in books/<client>/02-demand/demand-daily-<period>-v<nnn>.csv (or its JSON form). Each metric field is a ledger-row envelope. Column-level definition_ref and grade are stated in the file header when the CSV form is used; the JSON form carries them per field.",
  "type": "object",
  "required": ["date", "region", "channel", "platform", "offered", "handled", "handled_in_sl", "abandoned", "aht_elapsed_s", "aht_agent_work_s", "version", "actor"],
  "properties": {
    "date": { "$ref": "ledger-row.schema.json#/$defs/date" },
    "region": { "$ref": "ledger-row.schema.json#/$defs/region" },
    "channel": { "$ref": "ledger-row.schema.json#/$defs/channel" },
    "platform": { "$ref": "ledger-row.schema.json#/$defs/platform" },
    "offered": { "$ref": "#/$defs/metric", "description": "cites offered" },
    "handled": { "$ref": "#/$defs/metric", "description": "cites handled" },
    "handled_in_sl": { "$ref": "#/$defs/metric", "description": "cites handled-in-sl" },
    "abandoned": { "$ref": "#/$defs/metric", "description": "cites abandoned" },
    "abandoned_short": { "$ref": "#/$defs/metric", "description": "cites abandoned (short-abandon tag)" },
    "asa_s": { "$ref": "#/$defs/metric", "description": "cites asa" },
    "sl_pct": { "$ref": "#/$defs/metric", "description": "cites service-level" },
    "aht_elapsed_s": { "$ref": "#/$defs/metric", "description": "cites aht-elapsed. Never labelled AHT." },
    "aht_agent_work_s": { "$ref": "#/$defs/metric", "description": "cites aht-agent-work. The staffing number." },
    "re_contacts": { "$ref": "#/$defs/metric", "description": "cites contact (re-contact tag)" },
    "transactions": { "$ref": "#/$defs/metric", "description": "cites transaction; attributed by traveler-profile region" },
    "active_travelers": { "$ref": "#/$defs/metric", "description": "cites contacts-per-traveler-day (population input); E at day grain" },
    "version": { "type": "string", "pattern": "^v[0-9]{3}$" },
    "actor": { "$ref": "ledger-row.schema.json#/$defs/actor" },
    "qa": {
      "description": "DataEngineer reconciliation result for the row.",
      "type": "object",
      "properties": {
        "identity_ok": { "type": "boolean", "description": "offered = handled + abandoned + carried (voice/chat)" },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "metric": { "$ref": "ledger-row.schema.json" }
  }
}
