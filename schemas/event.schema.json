{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "horizon/schemas/event.schema.json",
  "title": "Event",
  "description": "One entry in the intelligence ledger books/<client>/05-events/. Typed, dated, with an effect window and a grade. Proposed by the Scout or Librarian; accepted by a planner.",
  "type": "object",
  "required": ["id", "type", "title", "start", "effect_window_days", "regions", "grade", "source", "actor", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^EV-[0-9]{3,}$", "description": "Permanent, never reused" },
    "type": {
      "type": "string",
      "enum": ["go-live", "outage", "weather", "holiday", "client-event", "product-change", "business-ask", "other"]
    },
    "title": { "type": "string", "description": "One sentence a reader with no context could act on" },
    "description": { "type": "string" },
    "start": { "type": "string", "format": "date-time" },
    "end": { "type": "string", "format": "date-time", "description": "Omit while ongoing" },
    "effect_window_days": {
      "description": "Days after start (or after end, if given) during which the event is expected to move demand or supply. Used by the PostAnalyst to match events to misses.",
      "type": "number",
      "minimum": 0
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "ledger-row.schema.json#/$defs/region" }
    },
    "channels": {
      "type": "array",
      "items": { "$ref": "ledger-row.schema.json#/$defs/channel" }
    },
    "expected_effect": {
      "description": "What the event is expected to do, as a direction and an estimate, graded.",
      "type": "object",
      "properties": {
        "side": { "type": "string", "enum": ["demand", "supply", "both", "unknown"] },
        "direction": { "type": "string", "enum": ["up", "down", "mixed", "unknown"] },
        "magnitude": { "$ref": "ledger-row.schema.json" }
      }
    },
    "structural_or_transitional": {
      "description": "Whether the effect persists into steady state (structural) or passes (transitional). Required before an event is cited in a capacity plan.",
      "type": "string",
      "enum": ["structural", "transitional", "unknown"]
    },
    "grade": { "$ref": "ledger-row.schema.json#/$defs/grade" },
    "source": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["client-calendar", "email", "monitoring", "weather-feed", "news", "internal", "other"] },
        "ref": { "type": "string" }
      }
    },
    "status": { "type": "string", "enum": ["proposed", "accepted", "rejected", "closed"] },
    "accepted_by": { "$ref": "ledger-row.schema.json#/$defs/actor" },
    "linked_questions": { "type": "array", "items": { "type": "string", "pattern": "^XR-[0-9]{3,}$" } },
    "actor": { "$ref": "ledger-row.schema.json#/$defs/actor" },
    "written_at": { "type": "string", "format": "date-time" }
  }
}
